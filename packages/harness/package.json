{
  "name": "@stellaragent/harness",
  "version": "0.1.0",
  "description": "Deterministic local devnet and end-to-end test harness for StellarAgent",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reportOnFailure"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "bignumber.js": "9.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}

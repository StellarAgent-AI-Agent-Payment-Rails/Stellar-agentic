{
  "name": "stellaragent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Agent Payment Rails on Stellar — monorepo",
  "workspaces": [
    "sdk",
    "dashboard"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev:sdk": "npm run dev --workspace=sdk",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "license-check": "license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Unlicense;CC0-1.0' --excludePrivatePackages"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "license-checker": "^25.0.1"
  }
}
